{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowwood.be/schema/site.schema.json",
  "title": "Flowwood site",
  "type": "object",
  "required": [
    "name",
    "origin",
    "defaultLocale",
    "locales",
    "routes",
    "navigation",
    "footerLinks",
    "contact",
    "limits",
    "socials",
    "meta",
    "legal",
    "home",
    "ui"
  ],
  "$defs": {
    "localized": {
      "type": "object",
      "required": [
        "en",
        "nl"
      ],
      "properties": {
        "en": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "nl": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "description": "src is /media/<file>.webp|.jpg|.svg (hashed by the build, which also reads width and height from the file) or an absolute https URI (width and height required).",
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^(/media/[a-z0-9][a-z0-9._-]*\\.(webp|jpg|svg)|https://[^\\s\"'<>()]+)$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "position": {
          "type": "string",
          "pattern": "^\\d{1,3}% \\d{1,3}%$",
          "description": "CSS object-position, e.g. \"50% 60%\""
        }
      },
      "anyOf": [
        {
          "properties": {
            "src": {
              "pattern": "^/media/"
            }
          }
        },
        {
          "required": [
            "width",
            "height"
          ]
        }
      ],
      "additionalProperties": false
    },
    "strings": {
      "type": "object",
      "description": "UI strings: nested groups whose leaves are localized values ({name} placeholders allowed).",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/localized"
          },
          {
            "$ref": "#/$defs/strings"
          }
        ]
      }
    },
    "legalDocument": {
      "type": "object",
      "required": [
        "title",
        "updated",
        "sections"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/localized"
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "date of the last change, YYYY-MM-DD; shown at the top of the page"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "title",
              "body"
            ],
            "properties": {
              "title": {
                "$ref": "#/$defs/localized"
              },
              "body": {
                "$ref": "#/$defs/localized",
                "description": "paragraphs, one per line; shown before the list. Placeholders: {legalName} {address} {enterpriseNumber} {email} {phone} {countries} {from} {to} {submit} {remember} {forget}"
              },
              "list": {
                "$ref": "#/$defs/localized",
                "description": "optional bullet points, one per line, shown after the first paragraph"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s\"'<>/]+$"
    },
    "turnstileSiteKey": {
      "type": "string",
      "pattern": "^[0-9a-zA-Z_-]+$",
      "description": "public site key of the Cloudflare Turnstile widget that guards the contact form; 1x00000000000000000000AA is Cloudflare's always-pass test key"
    },
    "defaultLocale": {
      "enum": [
        "nl",
        "en"
      ]
    },
    "locales": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "code",
          "lang",
          "numberFormat"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "lang": {
            "type": "string",
            "description": "BCP 47 for <html lang> and hreflang",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          },
          "numberFormat": {
            "type": "string",
            "description": "Intl locale for money"
          }
        },
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "object",
      "description": "routeId → { locale: slug }. Empty slug = locale root. URL: /{locale}/{slug}/",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "pattern": "^([a-z0-9]+(-[a-z0-9]+)*)?$"
        }
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "footerLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "oneOf": [
          {
            "required": [
              "href"
            ]
          },
          {
            "required": [
              "route"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "key in ui.footer"
          },
          "href": {
            "type": "string",
            "pattern": "^(https://|mailto:|tel:|/|#)[^\\s\"'<>]*$"
          },
          "route": {
            "type": "string",
            "description": "key in routes"
          }
        },
        "additionalProperties": false
      }
    },
    "contact": {
      "type": "object",
      "required": [
        "phone",
        "email",
        "legalName",
        "address",
        "enterpriseNumber"
      ],
      "properties": {
        "phone": {
          "type": "string",
          "description": "as displayed; the tel: link drops the spaces",
          "pattern": "^\\+?[0-9 ()-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "shown on the contact page and the recipient of the contact form",
          "pattern": "^[^\\s\"'<>@]+@[^\\s\"'<>@]+\\.[a-z]{2,}$"
        },
        "legalName": {
          "type": "string",
          "description": "official company name, as registered in the KBO/BCE (Crossroads Bank for Enterprises)"
        },
        "address": {
          "type": "string",
          "description": "registered address as one line, e.g. \"Straat 1, 1000 Brussel, België\""
        },
        "enterpriseNumber": {
          "type": "string",
          "description": "enterprise number without \"BE\", e.g. 0123.456.789; the VAT number is BE followed by this number"
        }
      },
      "additionalProperties": false,
      "description": "how to reach Flowwood and who the seller is: shown in the footer, on the contact page and in the terms and privacy statement"
    },
    "limits": {
      "type": "object",
      "description": "maximum characters per form field, enforced by the forms and by functions/api/contact.js",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "socials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "href"
        ],
        "properties": {
          "id": {
            "enum": [
              "instagram",
              "facebook"
            ],
            "description": "icon in the footer, label in ui.footer"
          },
          "href": {
            "type": "string",
            "pattern": "^https://[^\\s\"'<>]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/localized"
          },
          "description": {
            "$ref": "#/$defs/localized"
          }
        },
        "additionalProperties": false
      }
    },
    "home": {
      "type": "object",
      "properties": {
        "hero": {
          "type": "object",
          "properties": {
            "products": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "autoplaySeconds": {
              "type": "number",
              "minimum": 2
            }
          }
        },
        "collection": {
          "type": "object",
          "properties": {
            "products": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "brandImage": {
          "$ref": "#/$defs/image"
        },
        "signature": {
          "$ref": "#/$defs/image"
        },
        "partners": {
          "type": "integer"
        }
      }
    },
    "legal": {
      "type": "object",
      "description": "the terms and conditions and the privacy statement, keyed by route",
      "required": [
        "terms",
        "privacy"
      ],
      "properties": {
        "terms": {
          "$ref": "#/$defs/legalDocument"
        },
        "privacy": {
          "$ref": "#/$defs/legalDocument"
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "$ref": "#/$defs/strings"
    }
  }
}
