{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowwood.be/schema/catalog.schema.json",
  "title": "Flowwood catalog",
  "type": "object",
  "required": ["customSize", "products", "collections"],
  "additionalProperties": false,
  "$defs": {
    "id": { "$ref": "../../model.json#/$defs/id" },
    "localized": { "$ref": "../../model.json#/$defs/localized" },
    "range": {
      "type": "object",
      "required": ["min", "max", "step"],
      "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number" } },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "customSize": {
      "type": "object",
      "required": ["height", "width", "surcharge", "pricePerCm", "roundTo"],
      "properties": {
        "height": { "$ref": "#/$defs/range" },
        "width": { "$ref": "#/$defs/range" },
        "surcharge": { "type": "number" },
        "pricePerCm": {
          "type": "object",
          "required": ["height", "width"],
          "properties": { "height": { "type": "number" }, "width": { "type": "number" } },
          "additionalProperties": false
        },
        "roundTo": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "products": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true, "description": "Ids of the products in content/products/<id>.json (each one follows model.json), in shop order. Every product file is listed exactly once." },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "items"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/localized" },
          "intro": { "$ref": "#/$defs/localized", "description": "One sentence that opens the collection on the shop page." },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["product"],
              "properties": {
                "product": { "$ref": "#/$defs/id" },
                "finish": { "$ref": "#/$defs/id" },
                "height": { "type": "integer" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
