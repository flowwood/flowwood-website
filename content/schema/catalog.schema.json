{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowwood.be/schema/catalog.schema.json",
  "title": "Flowwood catalog",
  "type": "object",
  "required": ["customSize", "products", "collections"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "localized": {
      "type": "object",
      "required": ["en", "nl"],
      "properties": { "en": { "type": "string" }, "nl": { "type": "string" } },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "description": "src is a URI: /media/… (hashed by the build) or an absolute https URI.",
      "required": ["src", "width", "height"],
      "properties": {
        "src": { "type": "string", "format": "uri-reference" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "position": { "type": "string", "description": "CSS object-position, e.g. \"50% 60%\"" }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": ["min", "max", "step"],
      "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number" } },
      "additionalProperties": false
    },
    "finish": {
      "type": "object",
      "required": ["id", "color", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "color": { "type": "string", "description": "CSS colour or gradient for the swatch" },
        "name": { "$ref": "#/$defs/localized" }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "customSize": {
      "type": "object",
      "required": ["height", "width", "surcharge", "pricePerCm", "roundTo"],
      "properties": {
        "height": { "$ref": "#/$defs/range" },
        "width": { "$ref": "#/$defs/range" },
        "surcharge": { "type": "number" },
        "pricePerCm": {
          "type": "object",
          "required": ["height", "width"],
          "properties": { "height": { "type": "number" }, "width": { "type": "number" } },
          "additionalProperties": false
        },
        "roundTo": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Sized products have sizing + pricing.base/perSizeStep; fixed products have dimensions + pricing.fixed.",
        "required": ["id", "name", "tone", "image", "summary", "pricing", "finishes"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "tone": { "enum": ["dark", "light"], "description": "Brightness of the image's lower left: drives hero text colour" },
          "image": { "$ref": "#/$defs/image" },
          "altImage": { "$ref": "#/$defs/image" },
          "gallery": { "type": "array", "items": { "$ref": "#/$defs/image" }, "description": "Further photos on the product page, after image and altImage. Prerender only." },
          "summary": { "$ref": "#/$defs/localized" },
          "description": { "$ref": "#/$defs/localized" },
          "dimensions": { "$ref": "#/$defs/localized" },
          "sizing": {
            "type": "object",
            "required": ["shape", "heights", "width"],
            "properties": {
              "shape": { "enum": ["square", "hexagon", "round", "oval"] },
              "heights": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
              "width": { "type": "integer" }
            },
            "additionalProperties": false
          },
          "pricing": {
            "type": "object",
            "oneOf": [
              { "required": ["base", "perSizeStep"], "properties": { "base": { "type": "number" }, "perSizeStep": { "type": "number" } }, "additionalProperties": false },
              { "required": ["fixed"], "properties": { "fixed": { "type": "number" } }, "additionalProperties": false }
            ]
          },
          "materials": { "$ref": "#/$defs/localized", "description": "Product page disclosure. Prerender only." },
          "care": { "$ref": "#/$defs/localized", "description": "Product page disclosure. Prerender only." },
          "finishes": { "type": "array", "items": { "$ref": "#/$defs/finish" }, "minItems": 1 }
        },
        "additionalProperties": false
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "items"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/localized" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["product"],
              "properties": {
                "product": { "$ref": "#/$defs/id" },
                "finish": { "$ref": "#/$defs/id" },
                "height": { "type": "integer" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
